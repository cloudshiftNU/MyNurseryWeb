@{
    Layout = "~/Views/Shared/_LayoutWelcome.cshtml";
    ViewData["Title"] = "MyNursery";
}

<div class="position-relative text-center" style="margin-top: 0; padding-top: 0; line-height: 1; width: 100%;">
    <img src="/assets/images/Vector.png" alt="Alternate Text" class="d-block w-100" style="margin-top: -3px; display: block; vertical-align: top;">
    <div class="position-absolute top-50 start-50 translate-middle" style="font-family: var(--main-font);">
        <h2 class="text-white mb-1" style="font-size: 2.5rem;">Gallery</h2>
    </div>
</div>


<div class="container mt-0">
    <h2 class="text-center mb-4">Our Nursery...</h2>
    <div class="row row-cols-1 row-cols-md-4 g-4">
        <div class="col">
            <div class="ratio ratio-4x3">
                <img src="~/images/nursery2.jpg" class="img-fluid border border-2 rounded object-fit-cover" alt="Gallery Image 1">
            </div>
        </div>
        <div class="col">
            <div class="ratio ratio-4x3">
                <img src="~/images/nursery2.jpg" class="img-fluid border border-2 rounded object-fit-cover" alt="Gallery Image 2">
            </div>
        </div>
        <div class="col">
            <div class="ratio ratio-4x3">
                <img src="~/images/nursery3.jpg" class="img-fluid border border-2 rounded object-fit-cover" alt="Gallery Image 3">
            </div>
        </div>
        <div class="col">
            <div class="ratio ratio-4x3">
                <img src="~/images/nursery4.jpg" class="img-fluid border border-2 rounded object-fit-cover" alt="Gallery Image 4">
            </div>
        </div>
        <div class="col">
            <div class="ratio ratio-4x3">
                <img src="~/images/nursery6.jpg" class="img-fluid border border-2 rounded object-fit-cover" alt="Gallery Image 5">
            </div>
        </div>
        <div class="col">
            <div class="ratio ratio-4x3">
                <img src="~/images/nursery6.jpg" class="img-fluid border border-2 rounded object-fit-cover" alt="Gallery Image 6">
            </div>
        </div>
    </div>
    <div class="text-center mt-4">
        <a href="#" class="btn btn-warning">See More <i class="bi bi-arrow-right"></i></a>
    </div>
    <div class="mt-5 bg-light p-4 rounded">
        <div class="text-center">
            <div class="ratio ratio-16x9">
                <img src="#" class="img-fluid border border-2 rounded object-fit-cover" alt="Nursery Video">
            </div>
        </div>
    </div>
</div>