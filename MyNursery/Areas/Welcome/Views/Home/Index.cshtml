@{
    Layout = "~/Views/Shared/_LayoutWelcome.cshtml";
    ViewData["Title"] = "MyNursery";
}

<!-- Hero Section -->
<section class="bg-light" style="background-image: linear-gradient(to right, #e6f3f7, #b3e0e6);">
    <div class="container-fluid">
        <div class="row align-items-center min-vh-100 position-relative">
            <div class="col-lg-6">
                <img src="~/images/nursery1.png" class="img-fluid" alt="Kids at Nursery" />
            </div>
            <div class="col-lg-6 text-start px-5" style="font-family: var(--main-font);">
                <h2 class="fw-bold" style="font-family: var(--main-font);">Start Learning With</h2>
                <h1 class="fw-bold display-5" style="font-family: var(--main-font);">We care Child Study</h1>
                <a href="#" class="btn text-white me-3" style="background-color: #f39f5f;">Explore</a>
            </div>
            <img src="~/assets/images/Vector1.png" alt="Alternate Text" class="w-100 position-absolute bottom-0 mt-n4" />
        </div>
    </div>
</section>

<!-- About Section -->
<section class="py-5 position-relative" style="background-color: #FFFFFF;">
    <div class="container">
        <div class="row align-items-center">
            <!-- Image Column -->
            <div class="col-md-5 text-center mb-4 mb-md-0">
                <div class="rounded-4 p-2 d-inline-block" style="width: 358px; height: 368px; overflow: hidden;">
                    <img src="~/images/nursery2.jpg" alt="nursery2"
                         class="img-fluid h-100 w-100" style="object-fit: cover; border-radius: 30% 70% 70% 30% / 30% 30% 70% 70%;">
                </div>
            </div>

            <!-- Text Column -->
            <div class="col-md-7" style="font-family: var(--main-font);">
                <p class="text-warning fw-bold mb-1" style="color: var(--primary-color);">About Us</p>
                <h2 class="fw-bold mb-3 text-primary-emphasis" style="font-family: var(--main-font); color: var(--secondary-color);">
                    Top Choice For Children
                </h2>
                <p class="text-muted fs-5 mb-4" style="font-family: var(--main-font); color: var(--muted-text);">
                    At Little Sprouts, we believe early childhood is a time to explore, connect, and grow.
                    Our nurturing team creates a joyful and secure space where children are free to be themselves and thrive.
                </p>

                <!-- Button + Phone -->
                <div class="d-flex align-items-center flex-wrap gap-3">
                    <a asp-controller="Home" asp-action="AboutPage" class="btn btn-primary text-white px-4 py-2">
                        <!-- Uses --primary-color -->
                        Learn More →
                    </a>
                    <div class="d-flex align-items-center text-muted" style="color: var(--muted-text);">
                        <i class="bi bi-telephone-fill me-2 fs-5" style="color: var(--primary-color);"></i>
                        <div>
                            <div class="small fw-bold">Call Us Now</div>
                            <div>+94 772563446</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

