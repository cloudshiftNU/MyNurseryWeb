                    </li>
                    <li class="nav-item">
                        <a class="nav-link text-dark" href="#">Admissions</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link text-dark" asp-controller="Home" asp-action="ContactPage">Contact</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link text-dark" asp-controller="Home" asp-action="AboutPage">About Us</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link text-dark" asp-controller="Home" asp-action="BlogPage">Blogs</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link text-dark" asp-controller="Home" asp-action="GalleryPage">Gallery</a>
                    </li>
                </ul>
            </div>

            <div class="d-none d-lg-block">
