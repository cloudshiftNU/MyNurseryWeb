<!DOCTYPE html>

<html>
<head>
    <title>@ViewBag.Title</title>

	<!-- Meta -->
	<meta charset="utf-8">
	<meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=0, minimal-ui">
	<meta http-equiv="X-UA-Compatible" content="IE=edge" />
	<meta name="description" content="" />
	<meta name="keywords" content="">
	<meta name="author" content="Codedthemes" />

    <!--rangana 3.4-->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.7/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css" rel="stylesheet">


    <!--custome css & fonts, colours-->
    <style>
        :root {
            /* Color Variables f39f5f */
            --primary-color: #f39f5f;
            --secondary-color: #70A6B1;
            --accent-color: #385469;
            --extra-light-bg: #EFF5F6;
            --light-bg: #f9f4ef;
            --text-color: #333;
            --muted-text: #777;
            
            /* Font Variable */
            --main-font: 'Comic Sans MS', cursive;
        }

        /* Use variables globally */

        body {
            font-family: var(--main-font);
            color: var(--text-color);
            margin: 0;
            padding: 0;
            /* background: lightyellow; */
        }

        .main-content {
            margin-top: 0 !important;
            padding-top: 0 !important;
            /* background: lightblue; */
        }
        .d-flex + div {
            overflow: hidden;
        }

        .navbar {
            top: 0;
            margin-bottom: 0;
        }

            body > div + div {
                margin-top: 0 !important;
                padding-top: 0 !important;
            }

        h1, h2, h3, h4, h5, h6 {
            font-family: var(--main-font);
        }

        .btn-primary {
            background-color: var(--primary-color);
            color: #fff;
        }

        .bg-accent {
            background-color: var(--accent-color);
        }

        .text-muted {
            color: var(--muted-text) !important;
        }

        .stats-section {
            background-color: var(--secondary-color);
            padding: 2rem 0;
            text-align: center;
            border-bottom: 5px solid var(--primary-color);
        }

            .stats-section .col {
                padding: 1rem;
                border-right: 1px solid #fff;
            }

                .stats-section .col:last-child {
                    border-right: none;
                }

            .stats-section h3 {
                color: #fff;
                font-size: 2rem;
                margin-bottom: 0.5rem;
            }

            .stats-section p {
                color: #fff;
                font-size: 1rem;
            }

        /* blog page */
        .card-img-top {
            background-color: #ccc;
            height: 200px;
        }

        .search-bar {
            max-width: 300px;
            margin: 0 auto;
        }

        .recent-posts {
            background-color: var(--light-bg);
            padding: 1rem;
        }

            .recent-posts a {
                color: var(--text-color);
                text-decoration: none;
            }

                .recent-posts a:hover {
                    color: var(--primary-color);
                }

        .full-content {
            display: none;
            margin-top: 1rem;
        }

        .show-full-content .full-content {
            display: block;
        }


        .wave-section {
            position: relative;
            background-color: #f1f7f8;
            padding: 100px 20px 60px 20px;
            text-align: center;
            overflow: hidden;
        }

        .wave-img {
            position: absolute;
            width: 100%;
            left: 0;
        }

        .vector-23 {
            bottom: 0;
            z-index: 1;
        }

        .vector-22 {
            bottom: 40px;
            z-index: 2;
        }

        .rotate-180 {
            transform: rotate(180deg);
        }

        .footer-waves {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100px;
            z-index: 1;
        }

            .footer-waves img.wave-img {
                position: absolute;
                width: 100%;
                left: 0;
            }

            .footer-waves .vector-22 {
                top: 0;
                z-index: 1;
            }

            .footer-waves .vector-23 {
                top: 20px;
                z-index: 2;
            }

        footer {
            position: relative;
            overflow: visible;
            min-height: 350px;
        }

            footer > .container {
                position: relative;
                z-index: 3;
                padding-top: 80px;
                padding-bottom: 40px;
            }

    </style>
</head>

<body style="margin: 0; padding: 0;">
