    </nav>

    <div style="margin: 0; padding: 0;">
        @RenderBody()
    </div>

    <!--Footer-->
    <footer class="text-white pt-0" style="background-color: #70A6B1 !important; position: relative; overflow: hidden;">
        <div class="footer-waves">
            <img src="~/assets/images/Vector 22.png" alt="Wave 22" class="wave-img vector-22">
            <img src="~/assets/images/Vector 23.png" alt="Wave 23" class="wave-img vector-23">
        </div>
        <div style="height: 60px;"></div>
        <div class="container pt-5 mt-5">
            <div class="row text-center text-md-start">
                <!-- Contact Info -->
                <div class="col-12 col-md-4 mb-3 mb-md-0">
                    <div class="d-flex justify-content-center justify-content-md-start mb-2">
